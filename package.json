{
  "name": "cudaweb-gaussian-splatting",
  "version": "0.1.0",
  "description": "WebGPU Gaussian Splatting - CUDA operations reimplemented for browsers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:wasm": "cd src/wasm && wasm-pack build --target web --out-dir ../../pkg",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.40"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
